# Example (Need copy to .env)

#-------------------------------------------
# MQTT Brokers
CHANNEL_IDS = 111111, 111112

CLIENT_ID = test
MQTT_USERNAME = test
MQTT_PASSWORD = test
#-------------------------------------------


#-------------------------------------------
# Kafka
PATH_TO_KAFKA_1_STORAGE=path
PATH_TO_KAFKA_2_STORAGE=path
#-------------------------------------------


#-------------------------------------------
# MinIO
MINIO_PATH=path
ACCESS_KEY=minioadmin
SECRET_KEY=minioadmin
S3A_ENDPOINT=http://minio:9000
S3_BUCKED=s3a://path
S3_BUCKED_CHECKPOINTLOCATION=s3a://path
ICEBERG_DB_PATH=s3a://path
ICEBERG_TABLE_PATH=s3a://path
ICEBERG_CHECKPOINTLOCATION_PATH=s3a://path
ICEBERG_CATALOG_WAREHOUSE=s3a://path
ICEBERG_TABLE=iceberg_catalog.db.table
ICEBERG_DB=iceberg_catalog.db
#-------------------------------------------


#------------------------------------------
# Superset
SUPERSET_KEY=test-key
SUPERSET_STORE_PATH=path
#------------------------------------------
